# ACE controller: AWX (src/, at the public commit nearest the vendor's 4.8.6)
# built the way controller-rhel9 (AAP 2.7) is built. Hermetic:
# hack/prefetch.sh controller, then hack/build.sh controller.
#
#   venv    /var/lib/awx/venv/awx, built in full from sdists the way AWX's own
#           Makefile does it offline (requirements_awx with --no-index), plus
#           what AWX takes from git, built from submodules
#   final   ubi9-minimal; the vendor's final stage, step for step (NOTES.md).
#           The venv arrives whole, as the vendor's does.

###############################################################################
# Builder: the venv. PIP_NO_INDEX/PIP_FIND_LINKS come from the prefetch.
###############################################################################
FROM registry.access.redhat.com/ubi9/ubi:9.8 AS venv
RUN dnf module enable -y postgresql:15 && \
    dnf install -y --nodocs python3.12 python3.12-devel gcc gcc-c++ make pkgconf-pkg-config \
      libpq-devel krb5-devel libffi-devel openssl-devel libxml2-devel libxslt-devel \
      xmlsec1-devel xmlsec1-openssl-devel libtool-ltdl-devel openldap-devel rust cargo && \
    dnf clean all
COPY requirements.txt /tmp/requirements.txt
COPY src/ /src/awx/
COPY django-ansible-base/ /src/django-ansible-base/
COPY awx-plugins/ /src/awx-plugins/
COPY awx-plugins-interfaces/ /src/awx-plugins-interfaces/
COPY system-certifi/ /src/system-certifi/
# None of the submodules has its .git, so setuptools-scm is told each version.
RUN python3.12 -m venv /var/lib/awx/venv/awx && \
    /var/lib/awx/venv/awx/bin/pip install --no-cache-dir -r /tmp/requirements.txt && \
    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_DJANGO_ANSIBLE_BASE=2.7.20260824 \
    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_AWX_PLUGINS_INTERFACES=0.0.1a6 \
    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_AWX_PLUGINS_CORE=0.1.dev0 \
      /var/lib/awx/venv/awx/bin/pip install --no-cache-dir --no-deps \
        /src/django-ansible-base /src/awx-plugins-interfaces /src/awx-plugins /src/system-certifi && \
    SETUPTOOLS_SCM_PRETEND_VERSION=4.8.6 \
      /var/lib/awx/venv/awx/bin/pip install --no-cache-dir --no-deps /src/awx

###############################################################################
# Final stage
###############################################################################
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8

ARG AWX_GIT_TAG=4.8.6
ENV AWX_GIT_TAG=${AWX_GIT_TAG:-}
ENV container=oci
ENV HOME="/var/lib/awx"
ENV XDG_CONFIG_HOME="/tmp/.config"
USER root
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8
ENV AWX_LOGGING_MODE=stdout

# The vendor's list, less c-ares and redis (neither is in UBI; grpcio carries
# its own c-ares, and redis runs in a container of its own).
RUN microdnf -y module enable 'nginx:1.24' 'postgresql:15' && \
    microdnf update --setopt=install_weak_deps=0 --nodocs -y && \
    microdnf install --setopt=install_weak_deps=0 --nodocs -y \
      glibc-langpack-en python3.12 python3.12-pyyaml python3.12-pip hostname \
      krb5-workstation nginx postgresql xmlsec1 xmlsec1-openssl git-core crontabs sshpass \
      git-lfs subscription-manager subversion sos rsync rsyslog crun zlib openldap \
      python3-libsemanage findutils podman-remote && \
    microdnf reinstall --setopt=install_weak_deps=0 --nodocs -y tzdata && \
    microdnf clean all

RUN groupadd -r awx && useradd -r -g awx -d /var/lib/awx -s /bin/bash awx && usermod -g root awx

COPY --from=venv /var/lib/awx/venv /var/lib/awx/venv

# PID 1 and the process manager come from the venv.
RUN ln -s /var/lib/awx/venv/awx/bin/dumb-init /usr/bin/dumb-init && \
    ln -s /var/lib/awx/venv/awx/bin/supervisord /usr/bin/supervisord && \
    ln -s /var/lib/awx/venv/awx/bin/supervisorctl /usr/bin/supervisorctl
RUN /var/lib/awx/venv/awx/bin/pip show awx | grep Version | cut -d " " -f 2 > /var/lib/awx/.tower_version
# What the venv needed only to build itself (AWX's
# requirements_tower_uninstall list, and then some).
RUN /var/lib/awx/venv/awx/bin/pip uninstall -y Cython hatchling maturin pathspec pluggy \
      semantic-version setuptools-rust setuptools-scm trove-classifiers wheel
RUN chmod g+w /etc/passwd
RUN mkdir -p /usr/share/awx /var/lib/awx/job_status /var/lib/awx/public/static/media \
             /var/lib/awx/venv/awx/lib64/python3.12/site-packages/awx/ui/build/static && \
    chown -R awx:awx /var/lib/awx && \
    mkdir -p /etc/tower && chgrp -R root /etc/tower && chmod -R g+w /etc/tower && \
    mkdir -p /var/log/tower && chown -R awx:awx /var/log/tower && \
    chgrp -R root /var/log/tower && chmod -R 770 /var/log/tower
RUN mkdir -p /var/run/supervisor && chown -R awx:awx /var/run/supervisor && \
    chgrp -R root /var/run/supervisor && chmod -R 770 /var/run/supervisor
RUN chmod -R 777 /var/log/nginx && chmod -R 777 /var/lib/nginx && \
    mkdir -p /var/run/tower && chown -R nginx:nginx /var/run/tower

COPY src/tools/ansible/roles/dockerfile/files/rsyslog.conf /var/lib/awx/rsyslog/rsyslog.conf
RUN mkdir -p /var/lib/awx/rsyslog /var/lib/awx/rsyslog/conf.d && \
    chown awx:root /var/lib/awx/rsyslog/rsyslog.conf && chmod 660 /var/lib/awx/rsyslog/rsyslog.conf && \
    mkdir -p /var/run/awx-rsyslog && chown -R awx:root /var/run/awx-rsyslog && \
    chmod -R 770 /var/run/awx-rsyslog
RUN mkdir -p /etc/receptor && chown -R awx:awx /etc/receptor && \
    chgrp -R root /etc/receptor && chmod -R 755 /etc/receptor
# Image names must be fully qualified: no short-name guessing at job time.
RUN mkdir -p /etc/containers/registries.conf.d/ && \
    echo "unqualified-search-registries = []" >> /etc/containers/registries.conf.d/force-fully-qualified-images.conf && \
    chmod 644 /etc/containers/registries.conf.d/force-fully-qualified-images.conf
RUN find /var/lib/awx -not -path '/var/lib/awx/venv*' | xargs chgrp root && \
    find /var/lib/awx -not -path '/var/lib/awx/venv*' | xargs chmod g+rw

# Command-line entry points into the venv, and their historical tower-* names.
RUN printf '%s\n' '#!/var/lib/awx/venv/awx/bin/python' 'import sys' 'from awx import manage' \
      'if __name__ == "__main__":' '    manage()' > /usr/bin/awx-manage && chmod +x /usr/bin/awx-manage
RUN printf '%s\n' '#!/bin/bash' 'exec /var/lib/awx/venv/awx/bin/python "$@"' > /usr/bin/awx-python && \
    chmod +x /usr/bin/awx-python
RUN ln -s /usr/bin/awx-python /usr/bin/tower-python && ln -s /usr/bin/awx-manage /usr/bin/tower-manage

COPY src/tools/ansible/roles/dockerfile/files/uwsgi.ini /etc/tower/uwsgi.ini
COPY supervisord_task.conf /etc/supervisord_task.conf
COPY supervisord_web.conf /etc/supervisord_web.conf
COPY supervisord_rsyslog.conf /etc/supervisord_rsyslog.conf
COPY src/tools/ansible/roles/dockerfile/files/launch_awx_web.sh /usr/bin/launch_awx_web.sh
COPY src/tools/ansible/roles/dockerfile/files/launch_awx_task.sh /usr/bin/launch_awx_task.sh
COPY src/tools/ansible/roles/dockerfile/files/launch_awx_rsyslog.sh /usr/bin/launch_awx_rsyslog.sh
COPY src/tools/scripts/rsyslog-4xx-recovery /usr/bin/rsyslog-4xx-recovery
COPY src/tools/ansible/roles/dockerfile/files/stop-supervisor /usr/local/bin/stop-supervisor
COPY src/tools/ansible/roles/dockerfile/files/wait-for-migrations /usr/bin/wait-for-migrations
RUN chmod +rx /usr/bin/launch_awx_web.sh /usr/bin/launch_awx_task.sh /usr/bin/launch_awx_rsyslog.sh \
      /usr/bin/wait-for-migrations /usr/local/bin/stop-supervisor /usr/bin/rsyslog-4xx-recovery
RUN rm -rf /var/cache/dnf

ENV DESCRIPTION="ACE controller: AWX, the automation controller"
LABEL name="ace-controller" \
      version="${AWX_GIT_TAG}" \
      summary="${DESCRIPTION}" \
      description="${DESCRIPTION}" \
      io.k8s.description="${DESCRIPTION}" \
      io.k8s.display-name="ACE controller" \
      io.openshift.tags="ace,automation,controller,awx" \
      maintainer="Jamie Sammons"

USER awx
WORKDIR /var/lib/awx
EXPOSE 8052
RUN AWX_MODE=defaults SKIP_SECRET_KEY_CHECK=yes SKIP_PG_VERSION_CHECK=yes \
    AWX_SKIP_CREDENTIAL_TYPES_DISCOVER=yes /usr/bin/awx-manage collectstatic --noinput --clear
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
