[Unit]
Description=ACE AWX task (controller dispatcher)
Requires=ace-postgres.service ace-redis.service
After=ace-postgres.service ace-redis.service

[Container]
ContainerName=ace-awx-task
Image=ghcr.io/ansible/awx:devel
Network=ace.network
# Run the task supervisor via a wrapper that skips launch_awx_task.sh's
# `awx-manage provision_instance` (no --hostname), which fails outside K8s;
# awx-init.sh provisions the instance once instead.
Exec=/etc/tower/awx-task-run.sh
Environment=OPENSSL_armcap=0
Volume=%h/ace/awx/SECRET_KEY:/etc/tower/SECRET_KEY:ro,Z
Volume=%h/ace/awx/conf.d/ace.py:/etc/tower/conf.d/ace.py:ro,Z
Volume=%h/ace/awx/awx-task-run.sh:/etc/tower/awx-task-run.sh:ro,Z

[Service]
Restart=on-failure
TimeoutStartSec=180

[Install]
WantedBy=default.target
