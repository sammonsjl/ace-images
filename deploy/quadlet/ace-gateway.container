[Unit]
Description=ACE Gateway (Jewel)
Requires=ace-postgres.service ace-redis.service
After=ace-postgres.service ace-redis.service

[Container]
ContainerName=ace-gateway
Image=ghcr.io/sammonsjl/ace-gateway:latest
Network=ace.network
PublishPort=8000:8000

# First (and only) node: entrypoint runs migrate + createsuperuser + authenticators --initialize
Environment=CONTAINER_NUMBER=1

# Database (unprefixed envvars mapped to DATABASES.default by settings_utils.py)
Environment=DATABASE_ENGINE=django.db.backends.postgresql
Environment=DATABASE_HOST=ace-postgres
Environment=DATABASE_PORT=5432
Environment=DATABASE_NAME=gateway
Environment=DATABASE_USER=gateway
Secret=ace_db_password,type=env,target=DATABASE_PASSWORD

# Redis (standalone) -> CACHES.primary.LOCATION
Environment=REDIS_URL=redis://ace-redis:6379
Environment=REDIS_MODE=standalone

# Django SECRET_KEY read from a file (podman secret mounted at /run/secrets/...)
Environment=GATEWAY_SECRET_KEY_FILE=/run/secrets/ace_gateway_secret_key
Secret=ace_gateway_secret_key

# Admin bootstrap creds (read by launch-gateway on first boot)
Volume=%h/ace/gateway/container-startup.yml:/opt/aap_gateway/src/container-startup.yml:ro,Z
# TLS for nginx (listens :8000 ssl). Self-signed for the smoke test.
Volume=%h/ace/gateway/gateway.crt:/etc/ansible-automation-platform/gateway/gateway.crt:ro,Z
Volume=%h/ace/gateway/gateway.key:/etc/ansible-automation-platform/gateway/gateway.key:ro,Z

[Service]
Restart=on-failure
# First boot builds/migrates; give it room before systemd calls it failed
TimeoutStartSec=300

[Install]
WantedBy=default.target
