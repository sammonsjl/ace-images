[Unit]
Description=ACE PostgreSQL
After=network-online.target

[Container]
ContainerName=ace-postgres
Image=docker.io/library/postgres:15
Network=ace.network
Environment=POSTGRES_DB=gateway
Environment=POSTGRES_USER=gateway
Secret=ace_db_password,type=env,target=POSTGRES_PASSWORD
Volume=ace-postgres-data.volume:/var/lib/postgresql/data:Z
HealthCmd=pg_isready -U gateway -d gateway
HealthInterval=10s
HealthRetries=6
HealthStartPeriod=30s

[Service]
Restart=always

[Install]
WantedBy=default.target
