# ACE EDA: eda-server (src/, at the public commit nearest the vendor's 1.3.8)
# built the way eda-controller-rhel9 (AAP 2.7) is built. Hermetic:
# hack/prefetch.sh eda, then hack/build.sh eda.
#
#   wheels  every Python package from its sdist, plus django-ansible-base,
#           eda-server and system-certifi from their submodules
#   final   ubi9-minimal; the vendor's final stage, step for step (NOTES.md)

###############################################################################
# Builder: wheels. PIP_NO_INDEX/PIP_FIND_LINKS come from the prefetch.
###############################################################################
FROM registry.access.redhat.com/ubi9/ubi:9.8 AS wheels
RUN dnf install -y --nodocs python3.12 python3.12-pip python3.12-devel gcc \
      libpq-devel krb5-devel openssl-devel libffi-devel rust cargo && \
    dnf clean all
COPY requirements.txt build-constraints.txt /tmp/
COPY django-ansible-base/ /src/django-ansible-base/
COPY src/ /src/eda-server/
COPY system-certifi/ /src/system-certifi/
# Neither submodule has its .git, so the versions setuptools-scm would read
# from tags are given: the DAB release the vendor ships, and eda-server's own
# pyproject version (poetry-core reads that itself).
RUN PIP_CONSTRAINT=/tmp/build-constraints.txt \
      python3.12 -m pip wheel --no-cache-dir --wheel-dir /wheels -r /tmp/requirements.txt
RUN SETUPTOOLS_SCM_PRETEND_VERSION_FOR_DJANGO_ANSIBLE_BASE=2.7.20260824 \
      python3.12 -m pip wheel --no-cache-dir --no-deps --wheel-dir /wheels /src/django-ansible-base && \
    python3.12 -m pip wheel --no-cache-dir --no-deps --wheel-dir /wheels /src/eda-server && \
    python3.12 -m pip wheel --no-cache-dir --no-deps --wheel-dir /wheels /src/system-certifi

###############################################################################
# Final stage
###############################################################################
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8

RUN microdnf update --setopt=install_weak_deps=0 --nodocs -y && \
    microdnf install --setopt=install_weak_deps=0 --nodocs -y \
      git-core glibc-langpack-en libpq libyaml openssh openssl python3.12 python3.12-pip && \
    microdnf reinstall --setopt=install_weak_deps=0 --nodocs -y tzdata && \
    microdnf clean all && rm -rf /var/cache/dnf

# A system user and group of its own; the home, media and config directories
# writable by group root as well, for an arbitrary runtime uid.
RUN groupadd -r eda && \
    useradd -r -g eda -d /var/lib/ansible-automation-platform/eda -s /bin/bash eda && \
    mkdir -p /var/lib/ansible-automation-platform/eda/static \
             /var/lib/ansible-automation-platform/eda/media && \
    chown -R eda:eda /var/lib/ansible-automation-platform/eda && \
    chown eda:root /var/lib/ansible-automation-platform/eda \
                   /var/lib/ansible-automation-platform/eda/media && \
    chmod 775 /var/lib/ansible-automation-platform/eda \
              /var/lib/ansible-automation-platform/eda/media && \
    mkdir -p /etc/ansible-automation-platform/eda && \
    chown eda:root /etc/ansible-automation-platform/eda && \
    mkdir -m 770 -p /run/ansible-automation-platform/eda

COPY --from=wheels /wheels /tmp/wheels
COPY requirements/manual.in /tmp/requirements-manual.in
COPY requirements/poetry-export.in /tmp/requirements-poetry-export.in

# Into the system interpreter (--prefix /usr), no venv. django-ansible-base
# first, with its dependencies; then poetry.lock's pins without dependency
# resolution, minus the three lines it cannot use here; then certifi (the
# system-trust stub, the highest version on offer), eda-server itself, and
# the hand-written extras.
RUN python3.12 -m pip install --prefix /usr --no-cache-dir --no-index --find-links /tmp/wheels \
      django-ansible-base && \
    grep -v -E '(django-ansible-base|psycopg-binary|certifi)' /tmp/requirements-poetry-export.in \
      > /tmp/requirements-poetry.txt && \
    python3.12 -m pip install --prefix /usr --no-cache-dir --no-deps --no-index --find-links /tmp/wheels \
      -r /tmp/requirements-poetry.txt && \
    python3.12 -m pip install --prefix /usr --no-cache-dir --no-deps --no-index --find-links /tmp/wheels \
      certifi && \
    python3.12 -m pip install --prefix /usr --no-cache-dir --no-deps --no-index --find-links /tmp/wheels \
      aap-eda && \
    python3.12 -m pip install --prefix /usr --no-cache-dir --no-index --find-links /tmp/wheels \
      -r /tmp/requirements-manual.in && \
    rm -rf /tmp/*

ENV DESCRIPTION="ACE EDA: eda-server, the Event-Driven Ansible controller"
ARG AAP_EDA_CONTROLLER_GIT_TAG=1.3.5
LABEL name="ace-eda" \
      version="${AAP_EDA_CONTROLLER_GIT_TAG}" \
      summary="${DESCRIPTION}" \
      description="${DESCRIPTION}" \
      io.k8s.description="${DESCRIPTION}" \
      io.k8s.display-name="ACE EDA" \
      io.openshift.tags="ace,automation,eda,event-driven" \
      maintainer="Jamie Sammons"
ENV container=oci
ENV HOME=/var/lib/ansible-automation-platform/eda
ENV EDA_MEDIA_ROOT=/var/lib/ansible-automation-platform/eda/media
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8
USER eda
WORKDIR /var/lib/ansible-automation-platform/eda

RUN EDA_SECRET_KEY=dummy EDA_STATIC_ROOT=/var/lib/ansible-automation-platform/eda/static \
      aap-eda-manage collectstatic --noinput --clear

ENV EDA_GUNICORN_WORKERS=${EDA_GUNICORN_WORKERS:-2}
ENV EDA_GUNICORN_BIND=${EDA_GUNICORN_BIND:-0.0.0.0:8000}
ENV EDA_GUNICORN_LOG_LEVEL=info
CMD /bin/gunicorn --bind ${EDA_GUNICORN_BIND} --workers=${EDA_GUNICORN_WORKERS} \
    aap_eda.wsgi:application --log-level=${EDA_GUNICORN_LOG_LEVEL}
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
