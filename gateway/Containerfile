# ACE gateway: jewel (src/, at the public commit nearest the vendor's
# 2.7.20260824) plus the platform console from ansible-ui, built the way
# gateway-rhel9 (AAP 2.7) is built. Prefetched: hack/prefetch.sh gateway, then
# hack/build.sh gateway.
#
#   wheels  every Python package from its sdist, plus django-ansible-base,
#           jewel (as the aap-gateway package) and system-certifi from their
#           submodules
#   ui      the console, from ansible-ui's platform workspace
#   final   ubi9-minimal; the vendor's final stage, step for step (NOTES.md)

###############################################################################
# Builder: wheels. PIP_NO_INDEX/PIP_FIND_LINKS come from the prefetch.
###############################################################################
FROM registry.access.redhat.com/ubi9/ubi:9.8 AS wheels
# The few build headers UBI lacks come from CentOS Stream (hack/centos-stream9.repo),
# signed with CentOS's key, which ubi9 does not carry.
COPY RPM-GPG-KEY-centosofficial /etc/pki/rpm-gpg/
RUN rpm --import /etc/pki/rpm-gpg/RPM-GPG-KEY-centosofficial
RUN dnf install -y --nodocs python3.12 python3.12-pip python3.12-devel gcc gcc-c++ make \
      pkgconf-pkg-config libpq-devel openldap-devel libxml2-devel libxslt-devel \
      xmlsec1-devel xmlsec1-openssl-devel libtool-ltdl-devel openssl-devel libffi-devel \
      rust cargo && \
    dnf clean all
COPY requirements.txt /tmp/requirements.txt
COPY django-ansible-base/ /src/django-ansible-base/
COPY src/ /src/jewel/
COPY system-certifi/ /src/system-certifi/
# Everything arrives as a wheel where PyPI has one (hermeto.json), except
# lxml and xmlsec: each wheel carries its own copy of libxml2, the two copies
# differ, and xmlsec refuses to load beside an lxml built on another. Built
# here, both link UBI's one libxml2.
RUN PIP_NO_BINARY=lxml,xmlsec \
      python3.12 -m pip wheel --no-cache-dir --wheel-dir /wheels -r /tmp/requirements.txt
# No .git in the submodules, so the versions are given: setuptools-scm is told
# django-ansible-base's, and jewel reads its own from a VERSION file at the top
# of its tree (aap_gateway_api/version.py), which a release writes. Both are
# the releases the vendor image carries. jewel's package metadata names
# django-ansible-base by git URL (requirements_git.txt); a release names the
# package, so that is what goes in, and pip finds the wheel built just above.
RUN SETUPTOOLS_SCM_PRETEND_VERSION_FOR_DJANGO_ANSIBLE_BASE=2.7.20260824 \
      python3.12 -m pip wheel --no-cache-dir --no-deps --wheel-dir /wheels /src/django-ansible-base && \
    echo 2.7.20260824 > /src/jewel/VERSION && \
    sed -i 's| @ git+[^ ;]*||' /src/jewel/requirements/requirements_git.txt && \
      python3.12 -m pip wheel --no-cache-dir --no-deps --wheel-dir /wheels /src/jewel && \
    python3.12 -m pip wheel --no-cache-dir --no-deps --wheel-dir /wheels /src/system-certifi

###############################################################################
# Builder: the platform console. npm reads the prefetched packages through the
# rewritten package-lock.json (hack/prefetch.sh's inject-files).
###############################################################################
FROM registry.access.redhat.com/ubi9/ubi:9.8 AS ui
RUN dnf module enable -y nodejs:22 && dnf install -y --nodocs nodejs npm && dnf clean all
COPY ansible-ui/ /ui/
WORKDIR /ui
RUN npm ci --no-audit --no-fund && \
    cd platform && NODE_OPTIONS=--max-old-space-size=8192 npm run build

###############################################################################
# Final stage
###############################################################################
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8

ARG NGINX_VERSION=1.24

# The vendor also enables postgresql:15; UBI carries no such module stream, so
# the client is the default stream's.
RUN microdnf -y module enable nginx:$NGINX_VERSION && \
    microdnf update --setopt=install_weak_deps=0 --nodocs -y && \
    microdnf install --setopt=install_weak_deps=0 --nodocs -y \
      glibc glibc-langpack-en pcre2 python3.12 python3.12-pip libpq openssl \
      nginx postgresql xmlsec1 xmlsec1-openssl && \
    microdnf reinstall --setopt=install_weak_deps=0 --nodocs -y tzdata && \
    microdnf clean all

# A system user and group, also in group root for an arbitrary runtime uid.
RUN groupadd -r gateway && \
    useradd -r -g gateway -d /var/lib/ansible-automation-platform -s /sbin/nologin gateway && \
    usermod -aG root gateway && \
    mkdir -p /var/lib/ansible-automation-platform/platform/ui/static && \
    chown -R gateway:gateway /var/lib/ansible-automation-platform && \
    mkdir -m 770 -p /run/supervisor

COPY --from=wheels /wheels /tmp/wheels
COPY --from=ui /ui/platform/dist/ /var/lib/ansible-automation-platform/platform/ui

# Process supervision lives in the system interpreter; the application in a
# venv of its own, which then loses pip, as does the system.
RUN python3.12 -m pip install --prefix /usr --no-cache-dir --no-index --find-links /tmp/wheels \
      dumb-init supervisor requests
RUN mkdir -p /opt/aap-gateway && chgrp -R 0 /opt/aap-gateway && chmod -R g=u /opt/aap-gateway
RUN python3.12 -m venv /opt/aap-gateway/venv && \
    /opt/aap-gateway/venv/bin/pip install --no-cache-dir --no-index --find-links /tmp/wheels \
      'psycopg[c]' aap-gateway && \
    rm -rf /tmp/wheels
RUN /opt/aap-gateway/venv/bin/pip uninstall -y pip && \
    microdnf remove -y python3.12-pip && microdnf clean all

# The source tree on the path as well, through a .pth file.
RUN echo "/opt/aap-gateway/src" > /opt/aap-gateway/venv/lib/python3.12/site-packages/project.pth
COPY src/aap_gateway_api/ /opt/aap-gateway/src/aap_gateway_api/
ENV PYTHONPATH=/opt/aap-gateway/src
ENV PATH=/opt/aap-gateway/venv/bin:$PATH
COPY src/tools/scripts/aap-gateway-manage /usr/bin/aap-gateway-manage

# Runtime directories group-writable; the TLS pair pre-created so a bind
# mount lands on a file the gateway user may read.
RUN for dir in /etc/nginx /opt/aap_gateway /opt/aap_gateway/src /var/log/supervisor \
               /var/run/supervisor /var/run/uwsgi /var/log/nginx /var/run/django_metrics ; do \
      mkdir -m 0775 -p "$dir" ; chmod g+rwx "$dir" ; chgrp root "$dir" ; \
    done && \
    for file in /etc/nginx/gateway.crt /etc/nginx/gateway.key ; do \
      touch "$file" ; chmod g+rw "$file" ; chgrp root "$file" ; \
    done && \
    ln -s /usr/bin/aap-gateway-manage /usr/bin/gateway-manage

ENV DESCRIPTION="ACE gateway: the platform gateway and console"
ARG AAP_GATEWAY_GIT_TAG=2.7.20260824
# One LABEL per line, as the vendor's Containerfile writes them.
LABEL name="ace-gateway"
LABEL version="${AAP_GATEWAY_GIT_TAG}"
LABEL vendor="ACE"
LABEL summary="${DESCRIPTION}"
LABEL description="${DESCRIPTION}"
LABEL io.k8s.description="${DESCRIPTION}"
LABEL io.k8s.display-name="ACE gateway"
LABEL io.openshift.tags="ace,automation,gateway"
LABEL maintainer="Jamie Sammons"
ENV container=oci
USER root
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

RUN GATEWAY_SECRET_KEY_FILE=/dev/null \
    GATEWAY_STATIC_ROOT=/var/lib/ansible-automation-platform/platform/ui/static \
    /usr/bin/aap-gateway-manage collectstatic --noinput
RUN chown root:nginx -R /var/lib/ansible-automation-platform/platform

USER gateway
WORKDIR /opt
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
