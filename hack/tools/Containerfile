# The lockfile toolbox: everything hack/lock.sh needs, in one image, so the
# laptop and CI generate identical lockfiles.
#
#   rpm-lockfile-prototype  rpms.in.yaml -> rpms.lock.yaml (needs the system
#                           python's dnf bindings, hence a dnf-based base)
#   pip-tools               requirements.in -> requirements.txt with hashes
#   pybuild-deps            the PEP 517 build requirements of those packages
#
# Python 3.12 is what every image runs, so pip-compile resolves for 3.12.

FROM registry.access.redhat.com/ubi9/ubi:9.8

ARG RPM_LOCKFILE_PROTOTYPE_VERSION=v0.30.1

RUN dnf install -y --nodocs python3 python3-pip python3-dnf skopeo rpm \
      python3.12 python3.12-pip python3.12-devel gcc git-core && \
    dnf clean all && \
    python3 -m pip install --no-cache-dir \
      "https://github.com/konflux-ci/rpm-lockfile-prototype/archive/refs/tags/${RPM_LOCKFILE_PROTOTYPE_VERSION}.tar.gz" && \
    python3.12 -m pip install --no-cache-dir pip-tools pybuild-deps

WORKDIR /work
