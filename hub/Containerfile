# ACE hub: galaxy_ng (src/, at the public commit nearest the vendor's 4.12.5)
# on pulpcore, built the way hub-rhel9 (AAP 2.7) is built. Prefetched:
# hack/prefetch.sh hub, then hack/build.sh hub.
#
#   wheels  every Python package from its sdist, plus galaxy_ng,
#           django-ansible-base and system-certifi from their submodules
#   final   ubi9-minimal; the vendor's final stage, step for step (NOTES.md).
#           Like galaxy_ng's own Dockerfile, which it follows: one install
#           list, the system interpreter, a galaxy user, entrypoint.sh.

###############################################################################
# Builder: wheels. PIP_NO_INDEX/PIP_FIND_LINKS come from the prefetch.
###############################################################################
FROM registry.access.redhat.com/ubi9/ubi:9.8 AS wheels
RUN dnf install -y --nodocs python3.12 python3.12-pip python3.12-devel gcc gcc-c++ make \
      pkgconf-pkg-config libpq-devel openldap-devel libjpeg-turbo-devel zlib-devel \
      libxml2-devel libxslt-devel libffi-devel openssl-devel libyaml-devel rust cargo && \
    dnf clean all
COPY requirements.txt requirements.out build-constraints.txt /tmp/
COPY src/ /src/galaxy_ng/
COPY django-ansible-base/ /src/django-ansible-base/
COPY system-certifi/ /src/system-certifi/
# galaxy_ng's setup.py fetches the legacy hub UI from GitHub unless its target
# directory exists. The console is the gateway's now, so it stays empty.
RUN mkdir -p /src/galaxy_ng/galaxy_ng/app/static/galaxy_ng && \
    PIP_CONSTRAINT=/tmp/build-constraints.txt \
      python3.12 -m pip wheel --no-cache-dir --no-deps --wheel-dir /output/wheels -r /tmp/requirements.txt
RUN SETUPTOOLS_SCM_PRETEND_VERSION_FOR_DJANGO_ANSIBLE_BASE=2.7.20260824 \
      python3.12 -m pip wheel --no-cache-dir --no-deps --wheel-dir /output/wheels \
        /src/django-ansible-base /src/galaxy_ng /src/system-certifi && \
    cp /tmp/requirements.out /output/wheels/requirements.out

###############################################################################
# Final stage
###############################################################################
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8

ARG GALAXY_NG_GIT_TAG=4.12.0dev
ENV LANG=en_US.UTF-8 \
    DJANGO_SETTINGS_MODULE=pulpcore.app.settings \
    PULP_SETTINGS=/etc/pulp/settings.py \
    PYTHONUNBUFFERED=1 \
    AWS_REQUEST_CHECKSUM_CALCULATION=when_required \
    AWS_RESPONSE_CHECKSUM_VALIDATION=when_required

# The vendor's list, less c-ares (not in UBI).
RUN INSTALL_PKGS="glibc-langpack-en git-core libjpeg-turbo libpq libyaml libxslt python3.12 python3.12-pip gettext skopeo diffutils jq pinentry sshpass tar yajl" && \
    microdnf --setopt=install_weak_deps=0 --nodocs -y install ${INSTALL_PKGS} && \
    microdnf --setopt=install_weak_deps=0 --nodocs -y reinstall tzdata && \
    microdnf clean all && \
    ln -sf /usr/bin/python3.12 /usr/bin/python && \
    ln -sf /usr/bin/python3.12 /usr/bin/python3

COPY --from=wheels /output/wheels /output/wheels

# Into the system interpreter, every pin with --no-deps, then the three
# packages built from submodules.
RUN python3.12 -m pip install --prefix /usr --no-cache-dir --no-index --no-deps \
      --find-links /output/wheels -r /output/wheels/requirements.out && \
    python3.12 -m pip install --prefix /usr --no-cache-dir --no-index --no-deps \
      --find-links /output/wheels certifi django-ansible-base galaxy_ng && \
    rm -rf /output/wheels

# The galaxy user, in group root, with a subordinate id range for the podman
# the container registry part of pulp may run; pulp's directories; the static
# files the operator's nginx serves.
RUN adduser --uid 1000 --gid 0 --home-dir /var/lib/pulp --no-create-home galaxy && \
    usermod --add-subuids 100000-165535 --add-subgids 100000-165535 galaxy && \
    install -dm 0775 -o galaxy /var/lib/operator/static /var/lib/pulp/artifact \
      /var/lib/pulp/assets /var/lib/pulp/media /var/lib/pulp/scripts /var/lib/pulp/tmp \
      /etc/pulp/certs /etc/pulp/keys && \
    PULP_STATIC_ROOT=/var/lib/operator/static/ PULP_CONTENT_ORIGIN=localhost \
      pulpcore-manager collectstatic --clear --noinput --link

COPY src/galaxy-operator/bin/readyz.py /usr/bin/readyz.py
COPY src/docker/entrypoint.sh /usr/bin/entrypoint.sh
COPY src/docker/bin/ /usr/local/bin/

RUN chown galaxy:root -R /var/lib/pulp /var/lib/operator/static && \
    chmod 2775 /var/lib/pulp/scripts /var/lib/pulp/media /var/lib/pulp/tmp /var/lib/pulp/assets && \
    chown :root /var/lib/pulp/scripts /var/lib/pulp/media /var/lib/pulp/tmp /var/lib/pulp/assets && \
    chmod +x /usr/bin/entrypoint.sh && chmod +x /usr/bin/readyz.py

ENV DESCRIPTION="ACE hub: galaxy_ng on pulpcore, the automation content hub"
LABEL name="ace-hub" \
      version="${GALAXY_NG_GIT_TAG}" \
      summary="${DESCRIPTION}" \
      description="${DESCRIPTION}" \
      io.k8s.description="${DESCRIPTION}" \
      io.k8s.display-name="ACE hub" \
      io.openshift.tags="ace,automation,hub,galaxy" \
      maintainer="Jamie Sammons"

USER galaxy
ENTRYPOINT ["/usr/bin/entrypoint.sh"]
