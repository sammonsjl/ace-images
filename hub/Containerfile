# ACE hub — galaxy_ng on pulpcore, built from upstream source.
#
# Why built rather than pulled: quay.io/ansible/galaxy-ng is amd64-only and
# pulp/pulp-galaxy-ng is abandoned. The base is pulp's own multi-arch image;
# galaxy_ng comes from its upstream repo (Apache-2.0) at a pinned ref, and pip
# resolves the matching pulpcore / pulp_ansible / pulp-container pins from
# galaxy_ng's own setup.py.
#
# The image carries no configuration. The quadlets mount settings.py and the key
# material, and each container picks its process:
#   pulpcore-api / pulpcore-content / pulpcore-worker / pulpcore-manager

# Pinned, because :latest moves daily. 3.117 is CentOS Stream 10 with Python
# 3.12 — and the Python floor is what decides this, not the pulpcore version:
# galaxy_ng's lockfile pins ansible-core==2.21.0, which requires >=3.12. The
# 3.105 line is Stream 9 on Python 3.11 and cannot satisfy it.
#
# The base ships pulpcore 3.117; the constraints below pull it back to the
# 3.105.x that galaxy_ng actually wants. The base supplies the platform and
# the interpreter, the lockfile supplies the versions.
FROM docker.io/pulp/base:3.117

ARG GALAXY_NG_REF=1f2b27c70398aef9976188ecd23bbb750213befb          # ansible/galaxy_ng main @ 2026-08-27

ADD https://raw.githubusercontent.com/ansible/galaxy_ng/${GALAXY_NG_REF}/requirements/requirements.common.txt /tmp/galaxy-lock.txt

# galaxy_ng's own pip-compile lockfile, used as constraints.
#
# Without it pip backtracks: galaxy_ng's setup.py declares loose ranges and the
# resolver explores them for a very long time without failing. Constraining
# every version to the set galaxy_ng itself pinned turns resolution into a
# lookup.
#
# Two things have to be filtered out before pip will accept it:
#   1. Extras — pip refuses a constraints file whose entries carry them
#      ("Constraints cannot have extras"), and a pip-compile lockfile is full
#      of them. The version pin is the point; the extras are not.
#   2. Direct git references — a constraint must be a name and a version
#      specifier, and the lockfile pins django-ansible-base to a git ref. That
#      is also the one dependency we deliberately override below, so dropping
#      it here is exactly right.
RUN sed -E 's/\[[^]]*\]//' /tmp/galaxy-lock.txt | grep -v '@ git+' > /tmp/galaxy-constraints.txt

RUN pip3 install --no-cache-dir -c /tmp/galaxy-constraints.txt \
      "galaxy-ng @ https://github.com/ansible/galaxy_ng/archive/${GALAXY_NG_REF}.tar.gz"

# django-ansible-base must match the gateway's. The gateway builds against DAB
# devel, whose JWTs no longer carry a claim the pinned version still expects —
# so hub would reject every token the gateway signs.
ENV DJANGO_ANSIBLE_BASE_BRANCH=devel
# devel resolved to a commit @ 2026-09-10 so the build is reproducible.
# Re-check galaxy_ng's setup.py against this ref whenever GALAXY_NG_REF moves.
RUN pip3 install --no-cache-dir --upgrade \
      "django-ansible-base[feature-flags,jwt-consumer] @ git+https://github.com/ansible/django-ansible-base@3a099ee5fc4322397c79afcaf7dd1e045e2dc90c"

ENV PULP_SETTINGS=/etc/pulp/settings.py \
    DJANGO_SETTINGS_MODULE=pulpcore.app.settings \
    LANG=en_US.UTF-8 \
    container=oci \
    PYTHONUNBUFFERED=1

# Static assets baked at build time; whitenoise serves them. Group-root
# permissions so the image works at whatever uid it is given.
RUN mkdir -p /var/lib/operator/static /etc/pulp/keys /var/lib/pulp /var/tmp/pulp && \
    PULP_SECRET_KEY=build-only \
    PULP_CONTENT_ORIGIN=http://localhost \
    PULP_STATIC_ROOT=/var/lib/operator/static/ \
    PULP_DB_ENCRYPTION_KEY=/dev/null \
    PULP_REDIRECT_TO_OBJECT_STORAGE=False \
    pulpcore-manager collectstatic --noinput && \
    chgrp -R root /var/lib/operator/static /etc/pulp /var/lib/pulp /var/tmp/pulp && \
    chmod -R g=u /var/lib/operator/static /etc/pulp /var/lib/pulp /var/tmp/pulp

# A named user, and PYTHONUNBUFFERED=1 — the pulp/base image sets it to 0, which
# means pulpcore's output sits in a buffer instead of reaching the journal. That
# is a debugging tax you pay every time a worker misbehaves.
RUN useradd -u 1000 -g 0 -d /var/lib/pulp -M -s /bin/bash galaxy 2>/dev/null || true

# galaxy-operator starts each hub tier by the names and ports the official
# galaxy-ng image uses, and this image is built to take its process as the
# container command instead — which the podman track relies on. Under that
# operator the pods die immediately with "start-api: not found".
#
# Delegating to pulp/base's pulp-api is not enough: it binds 24817, while the
# operator's probes and containerPort say 8000 for the api and 24816 for
# content. So these bind what the operator expects. The waiters are aliases
# onto pulp/base's equivalents, which is all the originals do.
RUN set -eu; \
    printf '#!/bin/sh\n/usr/bin/wait_on_postgres.py\n/usr/bin/wait_on_database_migrations.sh\nexec pulpcore-api --bind "[::]:8000" --name pulp-api --access-logfile - "$@"\n' \
      > /usr/bin/start-api; \
    printf '#!/bin/sh\n/usr/bin/wait_on_postgres.py\n/usr/bin/wait_on_database_migrations.sh\nexec pulpcore-content --bind "[::]:24816" --name pulp-content --access-logfile - "$@"\n' \
      > /usr/bin/start-content-app; \
    cp /usr/bin/start-content-app /usr/bin/start-content; \
    printf '#!/bin/sh\n/usr/bin/wait_on_postgres.py\n/usr/bin/wait_on_database_migrations.sh\nexec pulpcore-worker "$@"\n' \
      > /usr/bin/start-worker; \
    printf '#!/bin/sh\nexec /usr/bin/wait_on_database_migrations.sh "$@"\n' > /usr/bin/wait-for-migrations; \
    printf '#!/bin/sh\nexec /usr/bin/wait_on_postgres.py "$@"\n' > /usr/bin/wait-for-postgres; \
    chmod +x /usr/bin/start-api /usr/bin/start-content-app /usr/bin/start-content \
             /usr/bin/start-worker /usr/bin/wait-for-migrations /usr/bin/wait-for-postgres

USER galaxy
WORKDIR /
