# Build backends of what is built from submodules: galaxy_ng and system-certifi
# (setuptools), django-ansible-base (setuptools + setuptools-scm).
setuptools>=64
setuptools-scm>=8
# scikit-build-core asks for these at build time (for rapidfuzz, and others),
# which pybuild-deps cannot see. Both are build tools that never reach an
# image, and both are taken as wheels (hermeto.json's binary filter): their
# sdists build CMake and Ninja themselves.
cmake>=3.15
ninja
# ast-serialize (a build tool in pytokens' chain, via mypy) is Rust that needs
# rustc 1.95, newer than UBI's 1.92, so it is taken as a wheel too.
# django-guid builds with poetry; poetry 2 turns its "^4.0 | ^5.0" Django
# range into metadata pip cannot parse, so its builds get poetry 1
# (build-constraints.txt).
poetry<2
