# ACE receptor: the execution mesh node, built from upstream source the way
# receptor-rhel9 (AAP 2.7) is built. Konflux-style: hack/prefetch.sh fetches
# every dependency, hack/build.sh builds with no network.
#
#   go      receptor from src/ (submodule at v1.6.7), CGO on
#   wheels  every Python package from its sdist
#   final   ubi9-minimal; the same steps, in the same order, as the vendor's
#           final stage (see NOTES.md)

###############################################################################
# Builder: receptor. Go modules come from the prefetch (GOMODCACHE/GOPROXY).
###############################################################################
FROM registry.access.redhat.com/ubi9/ubi:9.8 AS go
RUN dnf install -y --nodocs golang gcc binutils && dnf clean all
WORKDIR /src
COPY src/ .
# CGO on: RHEL's Go then uses the system OpenSSL (and its FIPS provider) for
# crypto, as the vendor binary does. Stripped; the version is the only -X.
ARG RECEPTOR_VERSION=v1.6.7+gitf5b7f8f
RUN CGO_ENABLED=1 go build -o receptor \
      -ldflags "-X 'github.com/ansible/receptor/internal/version.Version=${RECEPTOR_VERSION}'" \
      ./cmd/receptor-cl && \
    strip receptor

###############################################################################
# Builder: wheels. PIP_NO_INDEX and PIP_FIND_LINKS come from the prefetch, so
# pip sees only the sdists Hermeto fetched. The build backends go in first and
# everything is built against them without isolation, which is why every
# vendor wheel names the same generator (setuptools 82.0.1, flit 3.12.0).
###############################################################################
FROM registry.access.redhat.com/ubi9/ubi:9.8 AS wheels
RUN dnf install -y --nodocs python3.12 python3.12-pip python3.12-devel gcc && dnf clean all
COPY requirements.txt requirements-build.txt /tmp/
# PyPI's wheels where there are any (hermeto.json), except PyYAML: built here,
# without libyaml-devel, it has no C loader, as the vendor's has none.
RUN python3.12 -m pip install --no-cache-dir -r /tmp/requirements-build.txt && \
    PIP_NO_BINARY=pyyaml python3.12 -m pip wheel --no-cache-dir --no-build-isolation \
      --wheel-dir /wheels -r /tmp/requirements.txt

###############################################################################
# Final stage
###############################################################################
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8

ARG RECEPTOR_SRC_GIT_TAG=1.6.7

RUN microdnf update --nodocs --setopt=install_weak_deps=0 -y && \
    microdnf install --nodocs --setopt=install_weak_deps=0 -y \
      python3.12 \
      python3.12-pip \
      podman-remote && \
    microdnf clean all

COPY --from=go /src/receptor /usr/bin/receptor
COPY --from=wheels /wheels /tmp/wheels

RUN python3.12 -m pip install --no-cache-dir --no-index --find-links /tmp/wheels \
      --prefix /usr ansible-runner dumb-init && \
    rm -rf /tmp/wheels

ENV DESCRIPTION="ACE receptor: the execution mesh node" \
    container=oci

LABEL name="ace-receptor" \
      version="v${RECEPTOR_SRC_GIT_TAG}" \
      summary="${DESCRIPTION}" \
      description="${DESCRIPTION}" \
      io.k8s.description="${DESCRIPTION}" \
      io.k8s.display-name="ACE receptor" \
      io.openshift.tags="ace,automation,receptor" \
      maintainer="Jamie Sammons"

USER 1000

# dumb-init as PID 1: receptor spawns ansible-runner, which spawns
# podman-remote; without an init that reaps, a long-running mesh node
# accumulates zombies.
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["/usr/bin/receptor", "-c", "/etc/receptor/receptor.conf"]
